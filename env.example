# Copy to .env and fill in real values. Never commit the real .env file.
#
# Load before running any script:
#   set -a; source .env; set +a

# Preferred: a bearer token. Takes precedence over key/secret in every script.
CC_ACCESS_TOKEN=

# Fallback: API key/secret pair, used if CC_ACCESS_TOKEN is unset.
# Shared default for both export_cc_acls.py and apply_rolebindings.py.
CC_API_KEY=
CC_API_SECRET=

# Optional per-stage overrides, if you use separate key pairs for the
# Kafka data-plane (export) vs. IAM control-plane (apply) calls.
# Each falls back to CC_API_KEY/CC_API_SECRET above when unset.
CC_KAFKA_API_KEY=
CC_KAFKA_API_SECRET=
CC_IAM_API_KEY=
CC_IAM_API_SECRET=

# Cluster/org config. All of these can still be overridden per-command
# with the matching --flag (e.g. --cluster-id), which takes precedence.

# export_cc_acls.py
CC_CLUSTER_ID=
CC_REST_BASE_URL=

# acl_to_rolebindings.py --target cc (default)
CC_ORGANIZATION_ID=
CC_ENVIRONMENT_ID=
# Optional: overrides the cluster_id recorded in the ACL export file.
CC_KAFKA_CLUSTER_ID=

# --- Apache Ranger source (export_ranger_policies.py) ---
# Kafka cluster ID to record in the exported YAML; only needed if you don't
# pass --cluster-id.
RANGER_KAFKA_CLUSTER_ID=

# --- Confluent Platform / MDS target (acl_to_rolebindings.py --target cp-mds, apply_to_mds.py) ---
# Overrides cluster_id from the source file for the transform step.
CP_KAFKA_CLUSTER_ID=

# Base URL of the MDS REST API for apply_to_mds.py, e.g. https://mds.example.com:8090
MDS_URL=

# Preferred: a bearer token already issued by MDS. Takes precedence over
# MDS_USERNAME/MDS_PASSWORD below.
MDS_ACCESS_TOKEN=

# Fallback: MDS logs in with these (GET /security/1.0/authenticate) to obtain
# a token. NOTE: the MDS wire format in targets/cp_mds.py is a best-guess
# based on Confluent Platform's documented RBAC API and has not been
# verified against a live MDS instance -- confirm before using --apply.
MDS_USERNAME=
MDS_PASSWORD=
